             ih += 1
             hq[ih] = A[i,j]
     return hq
+
+
+def to_upper_triangular_vector_MF(A):
+    n = A.shape[0]
+    hq = np.zeros((n*(n+1)//2,))
+    ih = -1
+    for j in range(n):  # j = 0, ..., n-1
+        for i in range(j + 1):  # i = 0, ..., j
+            ih += 1
+            if A[i,j] != 0:
+                hq[ih] = A[i,j]
+            else:
+                hq[ih] = A[j,i]
+    return hq
+
